# DocGuru Environment Configuration

# Provider: google_ai | ollama | openai_compat | demo
MODEL_PROVIDER=google_ai
MODEL_NAME=gemma-4-31b-it
MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Google AI Studio / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Deprecated alias: GEMMA_API_KEY
GEMMA_API_KEY=

# LLM Generation Parameters
TEMPERATURE=0.2
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=3
LLM_THINKING=default
OUTLINE_MAX_TOKENS=1200
SECTION_MAX_TOKENS=1800

# Server & Security
DEBUG=false
LOG_CONTENT=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
RETENTION_HOURS=24
WORKER_THREADS=4
MAX_CONCURRENT_JOBS=4
MIN_FREE_MB=512

# Document & Presentation Options
PREVIEW_ENABLED=false
PAGE_BREAK_BETWEEN_SECTIONS=false

# Image Service Options
IMAGE_PLACEHOLDERS=false
IMAGE_CACHE_MAX_MB=500
IMAGE_TIMEOUT_SEC=8
IMAGE_BUDGET_SEC=25
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Frontend Proxy Target
BACKEND_URL=http://127.0.0.1:8000
