# AI Model Provider (google_ai, ollama, or openai_compat)
MODEL_PROVIDER=google_ai

# Gemma 4 Model Name (e.g. gemma-4-31b-it, gemma-4-26b-a4b-it, gemma-4-12b-it, gemma-4-e4b-it)
MODEL_NAME=gemma-4-31b-it

# API Endpoint (default Google AI Studio endpoint)
MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Google AI Studio / Gemini API Key
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here

# Sampling settings
TEMPERATURE=0.2
MAX_TOKENS=8192

# Backend Service URL (for Next.js proxy)
BACKEND_URL=http://127.0.0.1:8000
