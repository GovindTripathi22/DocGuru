{
  "name": "docguru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "setup": "node scripts/setup.mjs",
    "dev:all": "node scripts/dev_all.mjs",
    "test:backend": "python -m pytest backend/tests -v",
    "test:frontend": "npm run test:frontend:unit && node --experimental-default-type=module --test src/lib/generation-request.test.mjs",
    "test:frontend:unit": "vitest run --coverage",
    "test:e2e": "node scripts/run_e2e.mjs",
    "gen:api": "node scripts/gen_api.mjs",
    "gen:api:check": "npm run gen:api && git diff --exit-code -- src/types/api.generated.ts",
    "build": "next build && node scripts/prepare_standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
